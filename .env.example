# Copy to .env and fill in real values. Never commit .env.
# 路径不要加双引号（双引号内的 \n、\b 会被当成转义符），直接写或用单引号
# LLM 直连 OpenAI 兼容 API（agents/llm.py → {LLM_BASE_URL}/chat/completions），不需要任何 CLI
# LLM_BASE_URL 必填、无默认：不填启动即报错（防止 Key 静默发往错误服务商）
# 火山方舟 https://ark.cn-beijing.volces.com/api/v3
# 换服务商（DeepSeek/Kimi/GLM/Qwen…）：LLM_BASE_URL 改成其 base_url，ARK_API_KEY/ARK_MODEL 填它的 Key 和模型 ID
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-lite-260915
LLM_BASE_URL=
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR-KEY-HERE
DB_PATH=data/rsiqs.sqlite
CAPITAL=500000
MAX_PICKS=5

# 每个策略的持有天数（交易天数，自然日不算）。不填或非法时用 config._STRATEGY_HOLD_DAYS_DEFAULTS 默认值。
# 键名：HOLD_DAYS_<策略类 name 属性全大写>，下划线保留。值必须 >= 1 的整数。
# 策略类 name 见 strategies/*.py 第一行 class 属性：
#   BaselineMomo.name = "baseline_momo"            默认 5
#   LowIvMomo2610.name = "low_iv_momo_2610"        默认 5
#   MomoGapRev2611.name = "momo_gap_rev_2611"      默认 5
#   MomoIvGate2611.name = "momo_ivgate_2611"       默认 8
#   MomoTight2610.name = "momo_tight_2610"          默认 8
#   MomoTurnDry2611.name = "momo_turn_dry_2611"    默认 5
# 示例（都用默认值的话就全部注释掉）：
# HOLD_DAYS_BASELINE_MOMO=5
# HOLD_DAYS_LOW_IV_MOMO_2610=5
# HOLD_DAYS_MOMO_GAP_REV_2611=5
# HOLD_DAYS_MOMO_IVGATE_2611=8
# HOLD_DAYS_MOMO_TIGHT_2610=8
# HOLD_DAYS_MOMO_TURN_DRY_2611=5
